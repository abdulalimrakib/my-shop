# Copy to .env.local and fill in. Never commit real values.

# Sanity: project settings at https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-03-20
# Viewer token: server-side reads (the dataset should be private)
SANITY_API_READ_TOKEN=
# Editor token: webhook, addresses, newsletter and contact form writes
SANITY_API_TOKEN=

# Public site URL, used for Stripe redirects, canonical URLs and the sitemap
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Clerk: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stripe: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/webhook` locally,
# or the webhook endpoint's signing secret in production
STRIPE_WEBHOOK_SECRET=
